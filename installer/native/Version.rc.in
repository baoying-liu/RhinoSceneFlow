#include <windows.h>
1 VERSIONINFO
 FILEVERSION @SCENEFLOW_VERSION_COMMAS@,0
 PRODUCTVERSION @SCENEFLOW_VERSION_COMMAS@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @SCENEFLOW_FILETYPE@
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "baoying-liu\0"
   VALUE "FileDescription", "@SCENEFLOW_DESCRIPTION@\0"
   VALUE "FileVersion", "@SCENEFLOW_VERSION@.0\0"
   VALUE "ProductName", "SceneFlow\0"
   VALUE "ProductVersion", "@SCENEFLOW_VERSION@.0\0"
   VALUE "LegalCopyright", "Copyright (c) 2026 baoying-liu\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
